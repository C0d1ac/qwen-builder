COPY --from=downloader /model/model-00011-of-00131.safetensors /model/model-00011-of-00131.safetensors
COPY --from=downloader /model/model-00012-of-00131.safetensors /model/model-00012-of-00131.safetensors
COPY --from=downloader /model/model-00013-of-00131.safetensors /model/model-00013-of-00131.safetensors

