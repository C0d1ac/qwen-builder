FROM alpine:latest
RUN apk add --no-cache wget ca-certificates
WORKDIR /model

# Config & tokenizer
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/README.md" -O "/model/README.md"
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/chat_template.jinja" -O "/model/chat_template.jinja"
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/config.json" -O "/model/config.json"
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/generation_config.json" -O "/model/generation_config.json"
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/hf_quant_config.json" -O "/model/hf_quant_config.json"
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/merges.txt" -O "/model/merges.txt"
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/model.safetensors.index.json" -O "/model/model.safetensors.index.json"
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/preprocessor_config.json" -O "/model/preprocessor_config.json"
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/processor_config.json" -O "/model/processor_config.json"
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/tokenizer.json" -O "/model/tokenizer.json"
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/tokenizer_config.json" -O "/model/tokenizer_config.json"
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/video_preprocessor_config.json" -O "/model/video_preprocessor_config.json"
RUN wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/vocab.json" -O "/model/vocab.json"

# ~12.2GB layer
RUN \
    wget -q "https://huggingface.co/nvidia/Qwen3.8-Flash-Next-NVFP4/resolve/main/model-00002-of-00010.safetensors" -O "/model/model-00002-of-00010.safetensors"

