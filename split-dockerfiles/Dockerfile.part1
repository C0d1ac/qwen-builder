FROM alpine:latest
RUN apk add --no-cache wget ca-certificates
WORKDIR /model

# Config & tokenizer
RUN wget -q "https://huggingface.co/Qwen/Qwen3-0.6B/resolve/main/LICENSE" -O "/model/LICENSE"
RUN wget -q "https://huggingface.co/Qwen/Qwen3-0.6B/resolve/main/README.md" -O "/model/README.md"
RUN wget -q "https://huggingface.co/Qwen/Qwen3-0.6B/resolve/main/config.json" -O "/model/config.json"
RUN wget -q "https://huggingface.co/Qwen/Qwen3-0.6B/resolve/main/generation_config.json" -O "/model/generation_config.json"
RUN wget -q "https://huggingface.co/Qwen/Qwen3-0.6B/resolve/main/merges.txt" -O "/model/merges.txt"
RUN wget -q "https://huggingface.co/Qwen/Qwen3-0.6B/resolve/main/tokenizer.json" -O "/model/tokenizer.json"
RUN wget -q "https://huggingface.co/Qwen/Qwen3-0.6B/resolve/main/tokenizer_config.json" -O "/model/tokenizer_config.json"
RUN wget -q "https://huggingface.co/Qwen/Qwen3-0.6B/resolve/main/vocab.json" -O "/model/vocab.json"

# ~1.4GB layer
RUN \
    wget -q "https://huggingface.co/Qwen/Qwen3-0.6B/resolve/main/model.safetensors" -O "/model/model.safetensors"
