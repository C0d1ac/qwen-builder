# Part 4 of 7
# Shards: model-00060-of-00131.safetensors to model-00080-of-00131.safetensors
# Size: ~52.99 GB

FROM alpine:latest AS downloader
ARG HF_TOKEN
RUN apk add --no-cache git git-lfs ca-certificates
WORKDIR /downloads

RUN git lfs install && \
    git clone --depth 1 --filter=blob:none https://user:${HF_TOKEN}@huggingface.co/Qwen/Qwen3.8-Flash-Next repo && \
    cd repo && \
    git lfs pull \
        --include="model-00060-of-00131.safetensors" \
        --include="model-00061-of-00131.safetensors" \
        --include="model-00062-of-00131.safetensors" \
        --include="model-00063-of-00131.safetensors" \
        --include="model-00064-of-00131.safetensors" \
        --include="model-00065-of-00131.safetensors" \
        --include="model-00066-of-00131.safetensors" \
        --include="model-00067-of-00131.safetensors" \
        --include="model-00068-of-00131.safetensors" \
        --include="model-00069-of-00131.safetensors" \
        --include="model-00070-of-00131.safetensors" \
        --include="model-00071-of-00131.safetensors" \
        --include="model-00072-of-00131.safetensors" \
        --include="model-00073-of-00131.safetensors" \
        --include="model-00074-of-00131.safetensors" \
        --include="model-00075-of-00131.safetensors" \
        --include="model-00076-of-00131.safetensors" \
        --include="model-00077-of-00131.safetensors" \
        --include="model-00078-of-00131.safetensors" \
        --include="model-00079-of-00131.safetensors" \
        --include="model-00080-of-00131.safetensors" \
    && cd .. && \
    mkdir -p /model && \
    cd repo && \
    cp model-00060-of-00131.safetensors /model/ && \
    cp model-00061-of-00131.safetensors /model/ && \
    cp model-00062-of-00131.safetensors /model/ && \
    cp model-00063-of-00131.safetensors /model/ && \
    cp model-00064-of-00131.safetensors /model/ && \
    cp model-00065-of-00131.safetensors /model/ && \
    cp model-00066-of-00131.safetensors /model/ && \
    cp model-00067-of-00131.safetensors /model/ && \
    cp model-00068-of-00131.safetensors /model/ && \
    cp model-00069-of-00131.safetensors /model/ && \
    cp model-00070-of-00131.safetensors /model/ && \
    cp model-00071-of-00131.safetensors /model/ && \
    cp model-00072-of-00131.safetensors /model/ && \
    cp model-00073-of-00131.safetensors /model/ && \
    cp model-00074-of-00131.safetensors /model/ && \
    cp model-00075-of-00131.safetensors /model/ && \
    cp model-00076-of-00131.safetensors /model/ && \
    cp model-00077-of-00131.safetensors /model/ && \
    cp model-00078-of-00131.safetensors /model/ && \
    cp model-00079-of-00131.safetensors /model/ && \
    cp model-00080-of-00131.safetensors /model/ && \
    cd .. && rm -rf repo

FROM alpine:latest
WORKDIR /model

# Layer ~9.6 GB
COPY --from=downloader /model/model-00060-of-00131.safetensors /model/model-00060-of-00131.safetensors
